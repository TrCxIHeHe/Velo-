@@ -0,0 +1,90 @@
+"""Admin CRUD for /admin/dock-fares: authorization, validation, uniqueness."""
+import uuid
+
+from sqlalchemy import select
+
+from app.models import AuditLog
+
+URL = "/api/v1/admin/dock-fares"
+
+
+async def test_requires_authentication(client):
+    assert (await client.get(URL)).status_code == 401
+    assert (await client.post(URL, json={})).status_code == 401
+
+
+async def test_regular_user_is_forbidden(client, world):
+    a, b = await world.dock("A"), await world.dock("B")
+    body = {"origin_dock_id": str(a), "destination_dock_id": str(b), "amount": "20.00"}
+    assert (await client.post(URL, json=body, headers=world.headers)).status_code == 403
+    assert (await client.get(URL, headers=world.headers)).status_code == 403
+
+
+async def test_admin_creates_lists_and_updates(client, world, admin_headers, db_session):
+    a, b = await world.dock("A"), await world.dock("B")
+    created = await client.post(
+        URL, headers=admin_headers,
+        json={"origin_dock_id": str(a), "destination_dock_id": str(b), "amount": "20.50"},
+    )
+    assert created.status_code == 201, created.text
+    fare = created.json()["data"]
+    assert fare["amount"] == 20.5 and fare["currency"] == "INR" and fare["is_active"] is True
+    assert fare["created_at"].endswith("Z")
+
+    # reverse direction is a separate, independently priced row
+    rev = await client.post(
+        URL, headers=admin_headers,
+        json={"origin_dock_id": str(b), "destination_dock_id": str(a), "amount": "31"},
+    )
+    assert rev.status_code == 201 and rev.json()["data"]["amount"] == 31.0
+
+    listed = (await client.get(URL, headers=admin_headers)).json()["data"]
+    assert {(f["origin_dock_id"], f["amount"]) for f in listed} == {(str(a), 20.5), (str(b), 31.0)}
+    only_ab = (await client.get(f"{URL}?origin_dock_id={a}", headers=admin_headers)).json()["data"]
+    assert len(only_ab) == 1
+
+    upd = await client.patch(
+        f"{URL}/{fare['id']}", headers=admin_headers, json={"amount": "22.00", "is_active": False}
+    )
+    assert upd.status_code == 200
+    assert upd.json()["data"]["amount"] == 22.0 and upd.json()["data"]["is_active"] is False
+
+    actions = {r.action for r in (await db_session.execute(select(AuditLog))).scalars()}
+    assert {"DOCK_FARE_CREATED", "DOCK_FARE_UPDATED"} <= actions
+
+
+async def test_duplicate_directed_pair_is_rejected(client, world, admin_headers):
+    a, b = await world.dock("A"), await world.dock("B")
+    body = {"origin_dock_id": str(a), "destination_dock_id": str(b), "amount": "20"}
+    assert (await client.post(URL, json=body, headers=admin_headers)).status_code == 201
+    dup = await client.post(URL, json=body, headers=admin_headers)
+    assert dup.status_code == 409 and dup.json()["error"]["code"] == "FARE_ALREADY_EXISTS"
+
+
+async def test_validation(client, world, admin_headers):
+    a, b = await world.dock("A"), await world.dock("B")
+    post = lambda **kw: client.post(
+        URL, headers=admin_headers,
+        json={"origin_dock_id": str(a), "destination_dock_id": str(b), **kw},
+    )
+    assert (await post(amount="0")).status_code == 422
+    assert (await post(amount="-5")).status_code == 422
+    assert (await post(amount="12.345")).status_code == 422       # no silent rounding
+    assert (await post(amount="20", currency="RUPEES")).status_code == 422
+
+    same = await client.post(
+        URL, headers=admin_headers,
+        json={"origin_dock_id": str(a), "destination_dock_id": str(a), "amount": "20"},
+    )
+    assert same.status_code == 400 and same.json()["error"]["code"] == "FARE_INVALID_PAIR"
+
+    ghost = await client.post(
+        URL, headers=admin_headers,
+        json={"origin_dock_id": str(a), "destination_dock_id": str(uuid.uuid4()), "amount": "20"},
+    )
+    assert ghost.status_code == 404 and ghost.json()["error"]["code"] == "DOCK_NOT_FOUND"
+
+
+async def test_update_unknown_fare_is_404(client, admin_headers):
+    r = await client.patch(f"{URL}/{uuid.uuid4()}", headers=admin_headers, json={"amount": "9"})
+    assert r.status_code == 404 and r.json()["error"]["code"] == "FARE_NOT_FOUND"
diff --git a/backend/tests/pricing/test_pricing_strategy.py b/backend/tests/pricing/test_pricing_strategy.py
new file mode 100644
index 0000000..a043756
--- /dev/null
+++ b/backend/tests/pricing/test_pricing_strategy.py
@@ -0,0 +1,95 @@
+"""Fixed dock-pair strategy + the strategy abstraction itself."""
+import uuid
+from decimal import Decimal
+
+import pytest
+
+from app.core.exceptions import FareNotConfiguredError
+from app.pricing.fixed_pair import STRATEGY_FIXED_DOCK_PAIR, FixedDockPairStrategy
+from app.pricing.repository import DockPairFareRepository
+from app.pricing.service import PricingService
+from app.pricing.strategy import FareResult, PricingContext, PricingStrategy
+
+
+def _ctx(origin, destination, **kw):
+    return PricingContext(
+        ride_id=uuid.uuid4(), user_id=uuid.uuid4(),
+        origin_dock_id=origin, destination_dock_id=destination, **kw,
+    )
+
+
+async def test_fare_is_directional_and_independent(world, db_session):
+    a = await world.dock("A")
+    b = await world.dock("B")
+    await world.fare(a, b, "20.00")
+    await world.fare(b, a, "35.50")
+    pricing = PricingService(DockPairFareRepository(db_session))
+
+    ab = await pricing.calculate(_ctx(a, b))
+    ba = await pricing.calculate(_ctx(b, a))
+
+    assert ab.amount == Decimal("20.00") and ba.amount == Decimal("35.50")
+    assert ab.currency == "INR" and ab.strategy == STRATEGY_FIXED_DOCK_PAIR
+    assert ab.reference_id != ba.reference_id
+
+
+async def test_duration_does_not_change_a_fixed_fare(world, db_session):
+    a, b = await world.dock("A"), await world.dock("B")
+    await world.fare(a, b, "20.00")
+    pricing = PricingService(DockPairFareRepository(db_session))
+    short = await pricing.calculate(_ctx(a, b, duration_seconds=5))
+    long = await pricing.calculate(_ctx(a, b, duration_seconds=5 * 3600))
+    assert short.amount == long.amount == Decimal("20.00")
+
+
+async def test_missing_fare_raises_and_never_falls_back(world, db_session):
+    a, b = await world.dock("A"), await world.dock("B")
+    await world.fare(a, b, "20.00")  # only A->B; B->A is NOT configured
+    pricing = PricingService(DockPairFareRepository(db_session))
+    with pytest.raises(FareNotConfiguredError) as exc:
+        await pricing.calculate(_ctx(b, a, duration_seconds=3600))
+    assert exc.value.code == "FARE_NOT_CONFIGURED"
+
+
+async def test_inactive_fare_is_treated_as_missing(world, db_session):
+    a, b = await world.dock("A"), await world.dock("B")
+    await world.fare(a, b, "20.00", active=False)
+    with pytest.raises(FareNotConfiguredError):
+        await PricingService(DockPairFareRepository(db_session)).calculate(_ctx(a, b))
+
+
+async def test_unknown_strategy_name_is_a_configuration_error(db_session):
+    with pytest.raises(RuntimeError, match="Unknown PRICING_STRATEGY"):
+        _ = PricingService(DockPairFareRepository(db_session), strategy_name="nope").strategy
+
+
+async def test_new_strategy_plugs_in_without_touching_ride_completion(world, db_session):
+    """Extensibility proof: a time-based strategy is selected by name only.
+
+    ``RideService`` is not modified or subclassed — it just asks PricingService.
+    """
+    class PerMinuteStrategy(PricingStrategy):
+        name = "test_per_minute"
+
+        async def calculate(self, ctx):
+            minutes = max((ctx.duration_seconds or 0) // 60, 1)
+            return FareResult(amount=Decimal("3.00") * minutes, currency="INR", strategy=self.name)
+
+    a = await world.dock("A", vehicles=1)
+    b = await world.dock("B")
+    await world.fund(100)
+    ride = await world.start_ride(a)
+
+    svc = world.service()
+    original = svc.pricing._build_strategies
+    svc.pricing._strategy_name = "test_per_minute"
+    svc.pricing._build_strategies = lambda: {**original(), "test_per_minute": PerMinuteStrategy()}
+
+    ended = await svc.end_ride(world.user_id, ride.id, b)  # no fare row exists for A->B
+    assert ended.fare_amount == 3.0
+    assert ended.pricing_strategy == "test_per_minute"
+    assert await world.balance() == pytest.approx(97.0)
+
+
+def test_fixed_pair_is_a_pricing_strategy():
+    assert issubclass(FixedDockPairStrategy, PricingStrategy)
diff --git a/backend/tests/ride/test_cancel_activation_race.py b/backend/tests/ride/test_cancel_activation_race.py
new file mode 100644
index 0000000..e182536
--- /dev/null
+++ b/backend/tests/ride/test_cancel_activation_race.py
@@ -0,0 +1,100 @@
+"""Pending-ride cancellation vs. activation: an ACTIVE ride is never cancelled,
+and a cancelled ride is never activated."""
+import pytest
+from sqlalchemy import select, update
+
+from app.core.exceptions import RideInvalidStateError, RideTokenInvalidError
+from app.models import AuditLog, Ride
+
+
+async def _pending(world):
+    a = await world.dock("A", vehicles=1)
+    await world.fund(100)
+    svc = world.service()
+    token = await svc.request_ride_token(world.user_id, a)
+    await world.db.commit()
+    return a, svc, token
+
+
+async def _raw_status(world, ride_id, status):
+    """Change the row WITHOUT updating the already-loaded ORM object — i.e. the
+    state another request committed after this one read the ride."""
+    await world.db.execute(
+        update(Ride).where(Ride.id == ride_id).values(status=status)
+        .execution_options(synchronize_session=False)
+    )
+
+
+async def test_cancel_after_activation_is_rejected_and_ride_stays_active(client, world):
+    a, svc, token = await _pending(world)
+    ride = await svc.confirm_ride(token.ride_token, a)
+    await world.db.commit()
+
+    r = await client.post(f"/api/v1/rides/{ride.id}/cancel", headers=world.headers)
+    assert r.status_code == 409 and r.json()["error"]["code"] == "RIDE_INVALID_STATE"
+
+    stored = (await world.db.execute(select(Ride).where(Ride.id == ride.id))).scalar_one()
+    assert stored.status == "ACTIVE"
+    assert (await world.vehicle(ride.vehicle_id)).status == "IN_RIDE"
+
+
+async def test_cancel_loses_to_a_concurrent_activation(world):
+    """cancel read PENDING; the scan committed ACTIVE before cancel's UPDATE."""
+    a, svc, token = await _pending(world)
+    await svc.ride_repo.find_by_id(token.ride_id)           # cancel's read: PENDING
+    await _raw_status(world, token.ride_id, "ACTIVE")        # scan commits meanwhile
+
+    with pytest.raises(RideInvalidStateError):
+        await svc.cancel_pending_ride(world.user_id, token.ride_id)
+
+    status = (await world.db.execute(
+        select(Ride.status).where(Ride.id == token.ride_id))).scalar_one()
+    assert status == "ACTIVE"                                # NOT overwritten with CANCELLED
+    actions = [r.action for r in (await world.db.execute(select(AuditLog))).scalars()]
+    assert "RIDE_CANCELLED" not in actions
+
+
+async def test_confirm_loses_to_a_concurrent_cancel_and_touches_no_vehicle(world):
+    a, svc, token = await _pending(world)
+    await svc.ride_repo.find_by_jti(  # confirm's read: PENDING
+        __import__("hashlib").sha256(token.ride_token.encode()).hexdigest())
+    await _raw_status(world, token.ride_id, "CANCELLED")     # user cancelled meanwhile
+
+    with pytest.raises(RideTokenInvalidError):
+        await svc.confirm_ride(token.ride_token, a)
+
+    status = (await world.db.execute(
+        select(Ride.status).where(Ride.id == token.ride_id))).scalar_one()
+    assert status == "CANCELLED"
+    # the scooter was never released: still AVAILABLE and docked
+    from app.models import Vehicle
+    v = (await world.db.execute(select(Vehicle))).scalar_one()
+    assert v.status == "AVAILABLE" and v.slot_id is not None and await world.occupied(a) == 1
+
+
+async def test_stale_expiry_cannot_overwrite_an_activation(world):
+    a, svc, token = await _pending(world)
+    stale = await svc.ride_repo.find_by_id(token.ride_id)
+    await _raw_status(world, token.ride_id, "ACTIVE")
+    result = await svc._expire_ride(stale)
+    assert result.status == "ACTIVE"
+
+
+async def test_cancel_pending_is_idempotent(client, world):
+    a, svc, token = await _pending(world)
+    for _ in range(2):
+        r = await client.post(f"/api/v1/rides/{token.ride_id}/cancel", headers=world.headers)
+        assert r.status_code == 200 and r.json()["data"]["status"] == "CANCELLED"
+    # and the cancelled token can no longer unlock the scooter
+    with pytest.raises(RideTokenInvalidError):
+        await svc.confirm_ride(token.ride_token, a)
+
+
+async def test_new_token_supersedes_the_old_one(world):
+    a, svc, first = await _pending(world)
+    second = await svc.request_ride_token(world.user_id, a)
+    await world.db.commit()
+    with pytest.raises(RideTokenInvalidError):
+        await svc.confirm_ride(first.ride_token, a)
+    ride = await svc.confirm_ride(second.ride_token, a)
+    assert ride.status == "ACTIVE"
diff --git a/backend/tests/ride/test_end_ride.py b/backend/tests/ride/test_end_ride.py
new file mode 100644
index 0000000..414953c
--- /dev/null
+++ b/backend/tests/ride/test_end_ride.py
@@ -0,0 +1,230 @@
+"""End-ride: server-priced settlement, atomicity, idempotency, stale availability."""
+
+import pytest
+from sqlalchemy import select, update
+
+from app.core.exceptions import (
+    FareNotConfiguredError, InsufficientBalanceError, RideInvalidStateError,
+    SameDockReturnNotAllowedError,
+)
+from app.models import AuditLog, Ride
+
+
+async def _setup(world, *, fare="20.00", balance=100.0, dest_slots=2):
+    a = await world.dock("A", vehicles=1)
+    b = await world.dock("B", slots=dest_slots)
+    if fare:
+        await world.fare(a, b, fare)
+    await world.fund(balance)
+    ride = await world.start_ride(a)
+    return a, b, ride
+
+
+async def test_final_fare_is_the_configured_pair_fare_and_matches_the_debit(world):
+    a, b, ride = await _setup(world, fare="20.50")
+    ended = await world.service().end_ride(world.user_id, ride.id, b)
+
+    assert ended.status == "COMPLETED" and ended.end_dock_id == b
+    assert ended.fare_amount == 20.5 and ended.fare_currency == "INR"
+    assert ended.pricing_strategy == "fixed_dock_pair" and ended.pricing_reference_id
+    assert ended.started_at and ended.ended_at and ended.duration_seconds is not None
+
+    debits = await world.debits()
+    assert len(debits) == 1 and debits[0].amount == ended.fare_amount
+    assert await world.balance() == pytest.approx(100.0 - 20.5)
+    assert debits[0].balance_after == pytest.approx(79.5)
+
+    # scooter parked in a destination slot, origin slot freed
+    assert await world.occupied(b) == 1 and await world.occupied(a) == 0
+    vehicle = await world.vehicle(ride.vehicle_id)
+    assert vehicle.status == "AVAILABLE" and vehicle.slot_id is not None
+
+
+async def test_both_directions_are_priced_independently(world):
+    a, b, ride = await _setup(world, fare="20.00")
+    await world.fare(b, a, "35.00")
+    await world.service().end_ride(world.user_id, ride.id, b)          # A -> B = 20
+    back = await world.start_ride(b)
+    ended = await world.service().end_ride(world.user_id, back.id, a)  # B -> A = 35
+    assert ended.fare_amount == 35.0
+    assert await world.balance() == pytest.approx(100 - 20 - 35)
+
+
+async def test_duration_is_recorded_but_does_not_drive_the_fare(world, db_session):
+    from datetime import timedelta
+    from app.core.timeutil import naive_utcnow
+
+    a, b, ride = await _setup(world, fare="20.00")
+    await db_session.execute(
+        update(Ride).where(Ride.id == ride.id).values(started_at=naive_utcnow() - timedelta(hours=2))
+    )
+    await db_session.commit()
+    ended = await world.service().end_ride(world.user_id, ride.id, b)
+    assert 7195 <= ended.duration_seconds <= 7215
+    assert ended.fare_amount == 20.0
+
+
+async def test_client_cannot_choose_the_fare_or_origin(client, world):
+    """The request body only carries a destination; extra fields are ignored."""
+    a, b, ride = await _setup(world, fare="20.00")
+    r = await client.post(
+        f"/api/v1/rides/{ride.id}/end", headers=world.headers,
+        json={"dock_id": str(b), "fare_amount": 0.01, "start_dock_id": str(b)},
+    )
+    assert r.status_code == 200, r.text
+    assert r.json()["data"]["fare_amount"] == 20.0
+
+
+async def test_missing_fare_keeps_ride_active_and_changes_nothing(world):
+    a, b, ride = await _setup(world, fare=None)
+    with pytest.raises(FareNotConfiguredError):
+        await world.service().end_ride(world.user_id, ride.id, b)
+    await _assert_untouched(world, ride, b)
+
+
+async def test_insufficient_balance_rolls_back_slot_vehicle_and_ride(world):
+    a, b, ride = await _setup(world, fare="150.00", balance=100.0)
+    with pytest.raises(InsufficientBalanceError):
+        await world.service().end_ride(world.user_id, ride.id, b)
+    await _assert_untouched(world, ride, b)
+    assert await world.balance() == 100.0
+
+
+async def test_currency_mismatch_is_rejected_atomically(world):
+    from app.core.exceptions import CurrencyMismatchError
+    a = await world.dock("A", vehicles=1)
+    b = await world.dock("B")
+    await world.fare(a, b, "20.00", currency="USD")
+    await world.fund(100.0)
+    ride = await world.start_ride(a)
+    with pytest.raises(CurrencyMismatchError):
+        await world.service().end_ride(world.user_id, ride.id, b)
+    await _assert_untouched(world, ride, b)
+
+
+async def test_destination_filled_between_quote_and_completion(client, world):
+    a, b, ride = await _setup(world, fare="20.00", dest_slots=1)
+    est = await client.get(
+        f"/api/v1/rides/{ride.id}/fare-estimate?destination_dock_id={b}", headers=world.headers
+    )
+    assert est.status_code == 200                       # looked fine at quote time
+
+    slot = (await world.slots(b))[0]                    # someone else docks there
+    slot.is_occupied = True
+    await world.db.commit()
+
+    r = await client.post(f"/api/v1/rides/{ride.id}/end", headers=world.headers, json={"dock_id": str(b)})
+    assert r.status_code == 400 and r.json()["error"]["code"] == "DOCK_FULL"
+    await _assert_untouched(world, ride, b, dest_occupied=1)
+
+    # user picks another dock and gets a fresh quote
+    c = await world.dock("C")
+    await world.fare(a, c, "27.00")
+    q = (await client.get(
+        f"/api/v1/rides/{ride.id}/fare-estimate?destination_dock_id={c}", headers=world.headers
+    )).json()["data"]
+    assert q["fare_amount"] == 27.0
+    ok = await client.post(f"/api/v1/rides/{ride.id}/end", headers=world.headers, json={"dock_id": str(c)})
+    assert ok.status_code == 200 and ok.json()["data"]["fare_amount"] == 27.0
+
+
+async def test_same_dock_return_is_rejected(world):
+    a, b, ride = await _setup(world)
+    with pytest.raises(SameDockReturnNotAllowedError):
+        await world.service().end_ride(world.user_id, ride.id, a)
+    await _assert_untouched(world, ride, b)
+
+
+async def test_inactive_destination_is_rejected(world):
+    a, b, ride = await _setup(world)
+    closed = await world.dock("Closed", active=False)
+    await world.fare(a, closed, "10")
+    from app.core.exceptions import DockNotFoundError
+    with pytest.raises(DockNotFoundError):
+        await world.service().end_ride(world.user_id, ride.id, closed)
+
+
+async def test_repeated_end_is_idempotent_no_double_debit_or_slot(world):
+    a, b, ride = await _setup(world, fare="20.00")
+    first = await world.service().end_ride(world.user_id, ride.id, b)
+    second = await world.service().end_ride(world.user_id, ride.id, b)
+    third = await world.service().end_ride(world.user_id, ride.id, b)
+
+    assert first.id == second.id == third.id and second.fare_amount == first.fare_amount
+    assert len(await world.debits()) == 1
+    assert await world.balance() == pytest.approx(80.0)
+    assert await world.occupied(b) == 1
+
+
+async def test_ending_a_completed_ride_at_another_dock_is_a_conflict(world):
+    a, b, ride = await _setup(world)
+    c = await world.dock("C")
+    await world.fare(a, c, "11")
+    await world.service().end_ride(world.user_id, ride.id, b)
+    with pytest.raises(RideInvalidStateError):
+        await world.service().end_ride(world.user_id, ride.id, c)
+    assert len(await world.debits()) == 1 and await world.occupied(c) == 0
+
+
+async def test_lost_race_on_ride_state_cannot_double_complete(world, db_session):
+    """Another request completes the ride after we read it but before we write.
+    The compare-and-set must refuse and leave no partial writes."""
+    a, b, ride = await _setup(world)
+    svc = world.service()
+    real_calc = svc.pricing.calculate
+
+    async def racing_calc(ctx):
+        # concurrent transaction wins: ride is no longer ACTIVE
+        await db_session.execute(
+            update(Ride).where(Ride.id == ride.id).values(status="COMPLETED")
+            .execution_options(synchronize_session=False)
+        )
+        return await real_calc(ctx)
+
+    svc.pricing.calculate = racing_calc
+    with pytest.raises(RideInvalidStateError):
+        await svc.end_ride(world.user_id, ride.id, b)
+    assert await world.debits() == []
+    assert await world.occupied(b) == 0
+
+
+async def test_only_the_owner_can_end(client, world, other_auth_headers):
+    a, b, ride = await _setup(world)
+    r = await client.post(
+        f"/api/v1/rides/{ride.id}/end", headers=other_auth_headers, json={"dock_id": str(b)}
+    )
+    assert r.status_code == 403
+
+
+async def test_completion_is_audited_and_notified_after_commit(world, db_session):
+    a, b, ride = await _setup(world, fare="20.00")
+    await world.service().end_ride(world.user_id, ride.id, b)
+    actions = [r.action for r in (await db_session.execute(select(AuditLog))).scalars()]
+    assert "RIDE_ENDED" in actions and "WALLET_DEBIT_RIDE_FARE" in actions
+
+
+async def test_notification_failure_never_undoes_a_completed_ride(world, db_session):
+    from unittest.mock import AsyncMock
+    a, b, ride = await _setup(world, fare="20.00")
+    svc = world.service()
+    svc.notification_service = AsyncMock()
+    svc.notification_service.notify.side_effect = RuntimeError("push provider down")
+
+    ended = await svc.end_ride(world.user_id, ride.id, b)
+    assert ended.status == "COMPLETED"
+    stored = (await db_session.execute(
+        select(Ride).where(Ride.id == ride.id).execution_options(populate_existing=True))).scalar_one()
+    assert stored.status == "COMPLETED"
+    assert len(await world.debits()) == 1
+
+
+async def _assert_untouched(world, ride, dest, *, dest_occupied=0):
+    stored = (await world.db.execute(
+        select(Ride).where(Ride.id == ride.id).execution_options(populate_existing=True)
+    )).scalar_one()
+    assert stored.status == "ACTIVE"
+    assert stored.end_dock_id is None and stored.fare_amount is None and stored.ended_at is None
+    assert await world.occupied(dest) == dest_occupied
+    vehicle = await world.vehicle(ride.vehicle_id)
+    assert vehicle.status == "IN_RIDE" and vehicle.slot_id is None
+    assert await world.debits() == []
diff --git a/backend/tests/ride/test_end_ride_transactions.py b/backend/tests/ride/test_end_ride_transactions.py
new file mode 100644
index 0000000..3ac2904
--- /dev/null
+++ b/backend/tests/ride/test_end_ride_transactions.py
@@ -0,0 +1,138 @@
+"""Transaction control through the REAL request-session semantics.
+
+``app.database.get_db`` commits when the handler returns normally, and the ride
+router converts ``AppException`` into an ordinary error response. Without an
+explicit rollback in ``RideService.end_ride`` a failure after the first write
+would therefore be COMMITTED half-done. The shared-session ``client`` fixture
+hides that (it never commits), so this module uses separate sessions on a
+file-backed SQLite database and the production commit-on-exit dependency.
+"""
+import uuid
+from collections.abc import AsyncGenerator
+from decimal import Decimal
+
+import pytest_asyncio
+from httpx import ASGITransport, AsyncClient
+from sqlalchemy import func, select
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine
+
+from app.audit.repository import AuditLogRepository
+from app.core.firebase import get_firebase_service
+from app.core.redis import get_redis_client
+from app.database import Base, get_db
+from app.dock.repository import DockRepository, VehicleRepository
+from app.dock.schemas import DockCreate, VehicleCreate
+from app.dock.service import DockService
+from app.main import app
+from app.models import DockSlot, Ride, Vehicle, WalletTransaction
+from app.pricing.repository import DockPairFareRepository
+from app.ride.repository import RideRepository
+from app.ride.service import RideService
+from app.wallet.repository import WalletRepository
+from app.wallet.service import WalletService
+
+
+@pytest_asyncio.fixture
+async def real_env(tmp_path, firebase_mock, redis_mock):
+    engine = create_async_engine(f"sqlite+aiosqlite:///{tmp_path/'tx.db'}")
+    async with engine.begin() as conn:
+        await conn.run_sync(Base.metadata.create_all)
+    factory = async_sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
+
+    async def real_get_db() -> AsyncGenerator[AsyncSession, None]:  # same body as app.database.get_db
+        async with factory() as session:
+            try:
+                yield session
+                await session.commit()
+            except Exception:
+                await session.rollback()
+                raise
+
+    app.dependency_overrides[get_db] = real_get_db
+    app.dependency_overrides[get_firebase_service] = lambda: firebase_mock
+    app.dependency_overrides[get_redis_client] = lambda: redis_mock
+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
+        yield ac, factory, redis_mock
+    app.dependency_overrides.clear()
+    await engine.dispose()
+
+
+async def _scenario(real_env, *, fare: str | None, balance: float, dest_slots: int = 2):
+    client, factory, redis = real_env
+    login = await client.post("/api/v1/auth/login", json={"firebase_id_token": "uid"})
+    token = login.json()["data"]["access_token"]
+    user_id = uuid.UUID(login.json()["data"]["user"]["id"])
+    headers = {"Authorization": f"Bearer {token}"}
+
+    async with factory() as s:
+        docks = DockService(DockRepository(s), VehicleRepository(s))
+        a = (await docks.create_dock(DockCreate(name="A", location_lat=1, location_lng=1, total_slots=2))).id
+        b = (await docks.create_dock(
+            DockCreate(name="B", location_lat=2, location_lng=2, total_slots=dest_slots))).id
+        slot = await DockRepository(s).find_free_slot(a)
+        await docks.add_vehicle(VehicleCreate(qr_code="qr-1", battery_level=100, slot_id=slot.id))
+        if fare:
+            await DockPairFareRepository(s).create(a, b, Decimal(fare), "INR", True)
+        await WalletService(WalletRepository(s)).top_up(user_id, balance)
+        await s.commit()
+
+        svc = RideService(
+            RideRepository(s), DockRepository(s), VehicleRepository(s),
+            WalletService(WalletRepository(s), AuditLogRepository(s)), AuditLogRepository(s),
+            redis_client=redis,
+        )
+        tok = await svc.request_ride_token(user_id, a)
+        ride = await svc.confirm_ride(tok.ride_token, a)
+        await s.commit()
+    return client, factory, headers, ride, a, b
+
+
+async def _state(factory, ride_id, dest):
+    async with factory() as s:
+        ride = (await s.execute(select(Ride).where(Ride.id == ride_id))).scalar_one()
+        occupied = (await s.execute(
+            select(func.count()).select_from(DockSlot).where(DockSlot.dock_id == dest, DockSlot.is_occupied.is_(True))
+        )).scalar_one()
+        vehicle = (await s.execute(select(Vehicle).where(Vehicle.id == ride.vehicle_id))).scalar_one()
+        debits = (await s.execute(
+            select(func.count()).select_from(WalletTransaction).where(WalletTransaction.source == "RIDE_FARE")
+        )).scalar_one()
+        return ride, occupied, vehicle, debits
+
+
+async def test_failed_end_is_not_committed_half_done(real_env):
+    """150 fare vs 100 balance: the wallet debit fails AFTER the ride/slot/vehicle
+    writes. The request returns an error and nothing may be persisted."""
+    client, factory, headers, ride, a, b = await _scenario(real_env, fare="150.00", balance=100.0)
+
+    r = await client.post(f"/api/v1/rides/{ride.id}/end", headers=headers, json={"dock_id": str(b)})
+    assert r.status_code == 400 and r.json()["error"]["code"] == "WALLET_INSUFFICIENT_BALANCE"
+
+    stored, occupied, vehicle, debits = await _state(factory, ride.id, b)
+    assert stored.status == "ACTIVE" and stored.fare_amount is None and stored.end_dock_id is None
+    assert occupied == 0
+    assert vehicle.status == "IN_RIDE" and vehicle.slot_id is None
+    assert debits == 0
+
+
+async def test_successful_end_commits_everything_and_survives_replay(real_env):
+    client, factory, headers, ride, a, b = await _scenario(real_env, fare="20.00", balance=100.0)
+    end = lambda: client.post(f"/api/v1/rides/{ride.id}/end", headers=headers, json={"dock_id": str(b)})
+
+    first = await end()
+    assert first.status_code == 200 and first.json()["data"]["fare_amount"] == 20.0
+    replay = await end()   # e.g. the app retried after a dropped response
+    assert replay.status_code == 200 and replay.json()["data"]["id"] == first.json()["data"]["id"]
+
+    stored, occupied, vehicle, debits = await _state(factory, ride.id, b)
+    assert stored.status == "COMPLETED" and stored.fare_amount == 20.0
+    assert occupied == 1 and vehicle.status == "AVAILABLE" and vehicle.slot_id is not None
+    assert debits == 1
+
+
+async def test_missing_fare_via_http_leaves_ride_active(real_env):
+    client, factory, headers, ride, a, b = await _scenario(real_env, fare=None, balance=100.0)
+    r = await client.post(f"/api/v1/rides/{ride.id}/end", headers=headers, json={"dock_id": str(b)})
+    assert r.status_code == 409 and r.json()["error"]["code"] == "FARE_NOT_CONFIGURED"
+    stored, occupied, vehicle, debits = await _state(factory, ride.id, b)
+    assert stored.status == "ACTIVE" and occupied == 0 and debits == 0
