+"""Pricing: strategy (algorithm) / configuration (data) / ride lifecycle (orchestration).
+
+* ``strategy.py``   — the :class:`PricingStrategy` interface and value objects.
+* ``fixed_pair.py`` — first strategy: a configured fixed fare per directed dock pair.
+* ``service.py``    — :class:`PricingService`, the only thing the ride lifecycle talks to.
+* ``repository.py`` — storage of the dock-pair tariff table.
+* ``router.py``     — admin CRUD for the tariff table.
+
+Adding a strategy (distance, time, subscription, promo, surge...): see
+``docs/pricing-and-ride-lifecycle.md`` — implement ``PricingStrategy``, register
+it in ``PricingService.STRATEGIES`` and select it with ``PRICING_STRATEGY``.
+Ride completion does not change.
+"""
diff --git a/backend/app/pricing/fixed_pair.py b/backend/app/pricing/fixed_pair.py
new file mode 100644
index 0000000..c301d1d
--- /dev/null
+++ b/backend/app/pricing/fixed_pair.py
@@ -0,0 +1,34 @@
+from app.core.exceptions import FareNotConfiguredError
+from app.pricing.repository import DockPairFareRepository
+from app.pricing.strategy import FareResult, PricingContext, PricingStrategy
+
+STRATEGY_FIXED_DOCK_PAIR = "fixed_dock_pair"
+
+
+class FixedDockPairStrategy(PricingStrategy):
+    """Fare = the configured amount for the directed (origin -> destination) pair.
+
+    Ride duration is recorded elsewhere but deliberately does not affect this
+    fare. There is no fallback: a missing or inactive tariff is an error, never
+    a guessed price.
+    """
+
+    name = STRATEGY_FIXED_DOCK_PAIR
+
+    def __init__(self, fares: DockPairFareRepository) -> None:
+        self.fares = fares
+
+    async def calculate(self, ctx: PricingContext) -> FareResult:
+        fare = await self.fares.find_by_pair(ctx.origin_dock_id, ctx.destination_dock_id)
+        if fare is None or not fare.is_active:
+            raise FareNotConfiguredError()
+        return FareResult(
+            amount=fare.amount,
+            currency=fare.currency,
+            strategy=self.name,
+            reference_id=fare.id,
+            details={
