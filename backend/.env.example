# Copy to .env and fill in real values

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scooter_db

JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

ENVIRONMENT=development
API_V1_PREFIX=/api/v1

WALLET_DEFAULT_CURRENCY=INR
WALLET_MIN_RIDE_BALANCE=20

REDIS_URL=redis://localhost:6379/0

RIDE_TOKEN_SECRET=change_me_in_production
RIDE_TOKEN_ALGORITHM=HS256
RIDE_TOKEN_TTL_SECONDS=30
VEHICLE_BATTERY_MIN_THRESHOLD=20
