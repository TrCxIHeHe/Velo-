# Copy this file to .env and fill in real values. Never commit the real .env.

# IMPORTANT: keep this password free of special characters like # % @ : / -
# asyncpg/SQLAlchemy parses this as a URL, and unencoded special characters
# will break the connection string in ways that look like a totally
# unrelated error (e.g. "password authentication failed" or a URL parse error).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scooter_db

JWT_SECRET=dev_secret_change_before_deploy
ENVIRONMENT=development
