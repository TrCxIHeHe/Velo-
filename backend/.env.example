# Copy this file to .env and fill in real values. Never commit the real .env.
# Every variable below maps 1:1 to a field in app/config.py's Settings class --
# if you add a setting there, add it here too, or it'll silently fall back
# to that field's default instead of failing loudly.

# IMPORTANT: keep this password free of special characters like # % @ : / -
# asyncpg/SQLAlchemy parses this as a URL, and unencoded special characters
# will break the connection string in ways that look like a totally
# unrelated error (e.g. "password authentication failed" or a URL parse error).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scooter_db

# JWT access tokens -- RS256 (asymmetric). app/config.py bakes in a dev-only
# keypair as the default so local dev/tests need zero setup -- leave
# JWT_PRIVATE_KEY/JWT_PUBLIC_KEY UNSET (commented out, not set-to-empty) to
# use it. Generate a real 2048-bit RSA keypair and uncomment both PEM
# strings below before deploying anywhere real users can reach:
#   openssl genrsa -out key.pem 2048
#   openssl rsa -in key.pem -pubout -out pub.pem
JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Firebase Admin SDK -- project ID from the Firebase console, and the path
# to the service account JSON (gitignored, never commit the real file).
# Place it at backend/firebase-service-account.json to match the default
# below and the Docker Compose volume mount.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Redis -- backs atomic ride-token replay protection (SETNX, see
# app/ride/service.py::confirm_ride) and, in production, the rate limiter's
# shared storage. `docker compose up` in backend/docker starts one for you.
REDIS_URL=redis://localhost:6379/0

# Ride Token (QR)
RIDE_TOKEN_SECRET=dev_ride_secret_change_before_deploy
RIDE_TOKEN_ALGORITHM=HS256
RIDE_TOKEN_TTL_SECONDS=30
VEHICLE_BATTERY_MIN_THRESHOLD=20

# Wallet
WALLET_DEFAULT_CURRENCY=INR
WALLET_MIN_RIDE_BALANCE=20

# CORS -- comma-separated allowed origins, e.g. https://app.velo.com,https://admin.velo.com
# "*" only ever makes sense in local dev; main.py refuses to combine it with
# allow_credentials=True (browsers reject that combination anyway).
CORS_ORIGINS=*

# Razorpay -- leave blank in dev. POST /payments/orders returns 503 until
# RAZORPAY_KEY_ID/KEY_SECRET are set; the webhook returns 503 until
# RAZORPAY_WEBHOOK_SECRET is set (get all three from the Razorpay dashboard).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging -- set to false to disable push sends entirely
# (notifications still get written to the DB, just never pushed).
FCM_ENABLED=true
